{
  "name": "pi-stick",
  "private": true,
  "type": "module",
  "dependencies": {
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-codemode": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "pistick": "./pistick"
  },
  "scripts": {
    "build:binary": "./scripts/build-linux.sh",
    "build:image:dev": "./pistick-dev containers build",
    "update:runtime-deps": "node scripts/update-deps.mjs runtime",
    "update:dev-deps": "node scripts/update-deps.mjs dev",
    "dev": "PI_STICK_DEV=1 node src/cli.ts",
    "pack:npm": "./scripts/pack-npm.sh",
    "check": "npm run lint && tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "test": "node --test test/*.test.ts && bash test/scripts/install.sh",
    "test:docker-recovery": "bash test/integration/docker-recovery.sh"
  },
  "version": "0.2.0"
}
